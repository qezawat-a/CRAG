# ============ LLMs ============
# Providers "openai-compatible" | "anthropic" | "google" |

AI_PROVIDER=auto

# OpenAI-compatible
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=
ANTHROPIC_MODEL=

# Google (Gemini)
GEMINI_API_KEY=
GEMINI_BASE_URL=
GEMINI_MODEL=

AI_AUTO_REFRESH=0
AI_MODEL_TTL=600000

# ============ XT USDT-M Futures ============
# API keys az: https://xt.com (Futures API)
XT_FUTURES_HOST=https://fapi.xt.com
XT_API_KEY=
XT_API_SECRET=

# Trading defaults (FUTURES ONLY)
XT_DEFAULT_SYMBOL=btc_usdt
XT_TIMEFRAMES=1m,3m,5m,15m
# XT_DRY_RUN=1 bashad order/tpsl/close VAGHEI ejra NEMISHAN (preview mode, baraye test-e amn)
XT_DRY_RUN=1

# ============ Telegram Gateway (item 12) ============
# Bot token az @BotFather, user ID az @userinfobot (numeric)
TELEGRAM_BOT_TOKEN=
TELEGRAM_USER_ID=

# ============ Trader bot (Crypto2 port) ============
# AUTO_TRADE=1 -> scan -> signal -> open khodkar (XT_DRY_RUN=1 hanuz order nemifreste)
AUTO_TRADE=1
AGENT_AUTONOMOUS=0
AGENT_MAX_STEPS=8
AGENT_AUTONOMOUS_INTERVAL_SEC=60

# Trading defaults
DEFAULT_SYMBOL=btc_usdt
DEFAULT_LEVERAGE=75
DEFAULT_MARGIN_MODE=CROSSED
DEFAULT_TIMEFRAMES=1m,3m,5m,15m
DEFAULT_MARGIN_AMOUNT_PCT=25
DEFAULT_RISK_PCT=1
MIN_CONFIDENCE=80
TF_MIN_CONFIDENCE=70
MIN_AGREEING_STRATEGIES=2
SIGNAL_COOLDOWN_MINUTES=3
MAX_POSITIONS=1
SCAN_INTERVAL_SEC=15
GUARD_INTERVAL_SEC=15
REPORT_INTERVAL_SEC=300
BREAKEVEN_THRESHOLD_PCT=15
TRAILING_TRIGGER_ROI_PCT=20
TRAILING_DISTANCE_PCT=1
SL_LIQUIDATION_SAFETY=0.5
ON_TPSL_FAILURE=close
REVERSAL_ENABLED=1
REVERSAL_CONFIDENCE=85
PORT=8080
