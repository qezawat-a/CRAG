# ============ LLMs ============
# Providers "openai-compatible" | "anthropic" | "google" |

AI_PROVIDER=auto

# OpenAI-compatible
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=
ANTHROPIC_MODEL=

# Google (Gemini)
GEMINI_API_KEY=
GEMINI_BASE_URL=
GEMINI_MODEL=

AI_AUTO_REFRESH=0
AI_MODEL_TTL=600000

# ============ XT USDT-M Futures (SECRETS ONLY) ============
# API keys az: https://xt.com (Futures API)
XT_FUTURES_HOST=https://fapi.xt.com
XT_API_KEY=
XT_API_SECRET=
# Network tune (optional): retry backoff base (ms) va minimum gap beyn-e request ha (ms).
# Vaghti network-e mahal be-ham mire (EAI_AGAIN/ETIMEDOUT) meghdar-e balatar (mesl-e 1000)
# retry ha ro saboor-tar mikone; 0 = bedune-e delay (faghat baraye test).
# XT_RETRY_BASE_MS=500
# XT_MIN_REQUEST_MS=100

# XT_DRY_RUN=1 bashad order/tpsl/close VAGHEI ejra NEMISHAN (preview mode, baraye test-e amn)
# In ro ham mituni az agent avaz koni (tool xt_dry_run ya /dryrun), vali env ham ghabul-e.
XT_DRY_RUN=1

# ============ Trade settings: AGENT-ONLY (dar .env NANESED!) ============
# Tamame tanzimat-e trading (symbol, leverage, timeframes, min_confidence,
# cooldown, trailing, reversal, ...) FAGHAT az tarigh-e agent avaz mishan:
#   - Telegram: /settings (didan-e HAME) + /set key value + /get key + /reset_settings
#   - TUI: /tsettings + /tset key value
#   - Agent chat (tabii, hatta Farsi): "setting o neshun bede" ya "leverage ro 10 kon"
#     -> agent az tool haye trader_settings_get / trader_settings_set estefade mikone.
# Zakhire dar store-e (data/trader-store.json ya DATABASE_URL) — ba restart NEMIPARE.
# Env-haye ghadimi-e trading (DEFAULT_*, MIN_CONFIDENCE, SCAN_INTERVAL_SEC, ...)
# IGNORE mishan (ejra NEMISHAN) — lotfan az .env pakeshun kon.

# ============ Store / persistence ============
# DATABASE_URL bedi -> state (settings/trades/signals/cooldowns) mire rooye
# Postgres/MySQL-e DAEMI — mesl-e versione Python-e Crypto2 (SQLAlchemy).
# Bedune in, file-e data/trader-store.json estefade mishe ke ru deploy-e
# ephemeral (Railway/Heroku) ba har deploy PAK mishe (cooldown/ha ham miravan).
# Mesal (Neon): postgresql://user:pass@ep-xxx-pooler.neon.tech/neondb?sslmode=require
# Railway MySQL (niyaz be `npm install mysql2`): mysql://user:pass@host:3306/db
# DATABASE_URL=
# STORE_ID=default                  # chand bot ru yek DB? in ro joda kon
# STORE_FILE=data/trader-store.json # faghat vaghti DATABASE_URL nist

# ============ Telegram Gateway (item 12) ============
# Bot token az @BotFather, user ID az @userinfobot (numeric)
TELEGRAM_BOT_TOKEN=
TELEGRAM_USER_ID=

# ============ Trader bot (Crypto2 port) ============
# AUTO_TRADE=1 -> scan -> signal -> open khodkar (XT_DRY_RUN=1 hanuz order nemifreste)
AUTO_TRADE=1
AGENT_AUTONOMOUS=0
AGENT_MAX_STEPS=8
AGENT_AUTONOMOUS_INTERVAL_SEC=60

PORT=8080
